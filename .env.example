# Copia in .env.local e compila con i valori del progetto Supabase
# (Supabase → Project Settings → API). Sono chiavi pubbliche lato browser:
# la sicurezza dei dati è garantita dalle policy RLS nel database.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chiave pubblica VAPID per le notifiche push (vedi README, sezione Push)
VITE_VAPID_PUBLIC_KEY=
